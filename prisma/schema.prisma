// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessagePrivacy {
  EVERYONE
  FOLLOWERS
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  email          String    @unique
  passwordHash   String
  displayName    String?
  profilePicture String?   @default("https://via.placeholder.com/150")
  bio            String?
  gender         String?
  showGender     Boolean   @default(false)
  isPrivate      Boolean   @default(false)
  isVerified     Boolean   @default(false)
  pushToken      String?
  messagePrivacy          MessagePrivacy @default(EVERYONE)
  hideOnlineStatus        Boolean        @default(false)
  lastSeen                DateTime?
  closeFriends            String[]       @default([])
  hiddenStoryFrom         String[]       @default([]) // user IDs hidden from seeing my stories
  disappearingMsgTimer    String?        // null | "24h" | "7d"
  createdAt               DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resetCode        String?
  resetCodeExpires DateTime?
  deletionCode     String?
  deletionCodeExpiry DateTime?
  publicKey        String?   // E2EE public key for end-to-end encryption

  posts          Post[]    @relation("PostOwner")
  collabPosts    Post[]    @relation("PostCollab")
  likes          Like[]
  saves          Save[]
  comments       Comment[]
  stories        Story[]
  storyViews     StoryView[]
  storyReactions StoryReaction[]
  storyComments  StoryComment[]
  storyPollVotes StoryPollVote[]
  groupMembers   GroupMember[]
  groupMessages  GroupMessage[] @relation("GroupMessageSender")
  groupMessageReactions GroupMessageReaction[]
  
  // Follow System
  followers      Follow[]  @relation("FollowedUser")
  following      Follow[]  @relation("FollowingUser")
  
  // Direct Messages
  sentMessages     Message[] @relation("SentMessages")
  messageReactions MessageReaction[]
  notes            Note[]
  chatRoomsAs1     ChatRoom[] @relation("ChatRoomUser1")
  chatRoomsAs2     ChatRoom[] @relation("ChatRoomUser2")
  blocksInitiated  Block[]   @relation("Blocker")
  blocksReceived   Block[]   @relation("Blocked")
  
   notifications    Notification[]

   // Vibe Chat
   vibeTickets      VibeTicket[]  @relation("VibeTicketUser")
   vibeSessionsAs1  VibeSession[] @relation("VibeUser1")
   vibeSessionsAs2  VibeSession[] @relation("VibeUser2")
   vibeUsages       VibeUsage[]   @relation("VibeUsageUser")
   commentLikes     CommentLike[]
}

model Post {
  id             String    @id @default(uuid())
  userId         String
  type           String    // "image" or "reel"
  mediaUrl       String    // Cloudflare R2 URL
  thumbnailUrl   String?   // Picsum or Cloudflare R2 URL
  caption        String?
  category       String?   // "cricket", "tech", "gaming", "music"
  aspectRatio    Float?
  hideLikes      Boolean   @default(false)
  hideShares     Boolean   @default(false)
  collabUserId   String?   // the invited collab partner
  collabStatus   String?   // "pending" | "accepted" | "declined"
  scheduledAt    DateTime?
  isScheduled    Boolean   @default(false)
   visibility     String    @default("public") // "public" | "private" | "unlisted" | "close_friends"
  viewCount      Int       @default(0)
  shareCount     Int       @default(0)
  soundId        String?   // linked sound (if reel uses a sound)
  textLayers     Json?     // text overlay data for reels (position, style, content)
  audioUrl       String?   // background music URL for reels
  createdAt      DateTime  @default(now())

  user           User      @relation("PostOwner", fields: [userId], references: [id], onDelete: Cascade)
  collabUser     User?     @relation("PostCollab", fields: [collabUserId], references: [id], onDelete: SetNull)
  likes          Like[]
  saves          Save[]
  comments       Comment[]
  postViews      PostView[]
}

model PostView {
  id            String   @id @default(uuid())
  postId        String
  userId        String?  // null for anonymous/non-logged views
  gender        String?  // viewer's gender from their profile
  country       String?  // viewer's country
  device        String?  // "iPhone" | "Android" | "Web"
  source        String?  // "home" | "explore" | "search" | "direct" | "profile"
  watchDuration Float?   // seconds the user watched
  isPaidView    Boolean  @default(true) // false if flagged as fake/ineligible for earnings
  createdAt     DateTime @default(now())

  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Follow {
  id             String    @id @default(uuid())
  followerId     String
  followingId    String
  status         String    @default("accepted") // "pending" or "accepted"
  createdAt      DateTime  @default(now())

  follower       User      @relation("FollowingUser", fields: [followerId], references: [id], onDelete: Cascade)
  following       User      @relation("FollowedUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Like {
  id             String    @id @default(uuid())
  userId         String
  postId         String
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Save {
  id             String    @id @default(uuid())
  userId         String
  postId         String
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id             String    @id @default(uuid())
  userId         String
  postId         String
  text           String
  type           String    @default("text") // "text" | "gif"
  parentId       String?   // For nested replies
  isPinned       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent         Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[] @relation("CommentReplies")
  likes          CommentLike[]
}

model CommentLike {
  id             String    @id @default(uuid())
  userId         String
  commentId      String
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment        Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Story {
  id             String    @id @default(uuid())
  userId         String
  mediaUrl       String
  audience       String    @default("everyone") // "everyone" | "close_friends"
  stickerData    Json?     // Stores stickers (poll, mention, location, hashtag, etc.)
  frameData      Json?     // Stores { scale, x, y } for pinch-zoom & drag positioning
  createdAt      DateTime  @default(now())
  expiresAt      DateTime  // 24 hours after creation

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  views          StoryView[]
  reactions      StoryReaction[]
  comments       StoryComment[]
  pollVotes      StoryPollVote[]
}

model StoryPollVote {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  option    Int      // 0 or 1 (which poll option)
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  emoji     String   // e.g., "❤️", "😂", "😮", "😢", "😡"
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryComment {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  text      String
  createdAt DateTime  @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// —————————————————————————————
// CHAT SYSTEM (Messages + Rooms)
// —————————————————————————————

// 1-on-1 conversation thread
model ChatRoom {
  id              String    @id @default(uuid())
  user1Id         String
  user2Id         String
  isAccepted      Boolean   @default(false)
  // Mute: stored as comma-separated userIds who muted messages/calls
  mutedMessages   String[]  @default([])
  mutedCalls      String[]  @default([])
  // Soft-delete per user: stores userId of whoever deleted their copy
  deletedFor      String[]  @default([])
  deletedForAt    DateTime?
  // Vanish mode (per-user — userIds who have it enabled)
  vanishMode      String[]  @default([])
  // Vibe Chat: anonymous matching chat rooms (hidden from normal list until revealed)
  isVibe          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user1      User      @relation("ChatRoomUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2      User      @relation("ChatRoomUser2", fields: [user2Id], references: [id], onDelete: Cascade)
   messages   Message[]

   vibeSession VibeSession? @relation("VibeRoom")

   @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// Each message belongs to a ChatRoom
model Message {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  text      String?
  type      String   @default("text") // text | image | gif | audio | reel_share | post_share | story_reply
  mediaUrl  String?
  postId    String?
  storyId   String?
  replyToId String?  // For reply-to-message
  status    String   @default("SENT") // SENT | DELIVERED | SEEN

  // For audio messages
  audioDuration Int?    // seconds

  // Vanish mode
  isVanish  Boolean  @default(false)
  seenAt    DateTime?

  // Edit within 15 min
  edited    Boolean  @default(false)
  editedAt  DateTime?

  // Pin / Unpin
  isPinned  Boolean  @default(false)
  pinnedAt  DateTime?

  // Soft delete per-user
  deletedFor String[] @default([])

  // E2EE: encrypted message data (format: iv:ciphertext:tag)
  isEncrypted    Boolean  @default(false)
  encryptedData  String?  // stored if text is encrypted

  // Vibe Chat: anonymous matching chat rooms (hidden from normal list until revealed)
  isVibe         Boolean  @default(false)

  // Scheduled send
  scheduledAt DateTime?

  createdAt DateTime @default(now())

  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  @@index([roomId, createdAt])
  @@index([senderId])
}

// Reactions on messages (one reaction per user per message)
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// Block relationship
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  senderId    String
  type        String   // "follow_accepted", "like", "comment", "story_reaction", "story_comment", "message"
  text        String?
  postId      String?
  storyId     String?  // For story-related notifications
  createdAt   DateTime @default(now())
  isRead      Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Notes (24h disappearing text status, visible to followers) ──
model Note {
  id          String   @id @default(uuid())
  userId      String   @unique  // one active note per user
  text        String
  emoji       String?
  songUrl     String?
  songTitle   String?
  songArtist  String?
  songArtwork String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── Group Chats ──
model Group {
  id                     String        @id @default(uuid())
  name                   String
  avatar                 String?
  description            String?
  allowMembersToInvite   Boolean       @default(false)
  onlyAdminsCanSend      Boolean       @default(false)
  membersCanEditProfile  Boolean       @default(false)
  createdById            String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  members     GroupMember[]
  messages    GroupMessage[]
  polls       GroupPoll[]

  @@index([createdById])
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  role      String   @default("member")  // owner | admin | member
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  senderId  String
  text      String?
  type      String   @default("text") // text | image | gif | audio | system
  mediaUrl  String?
  audioDuration Int?
  replyToId String?
  edited    Boolean  @default(false)
  editedAt  DateTime?
  isPinned  Boolean  @default(false)
  deletedFor String[] @default([])
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  reactions GroupMessageReaction[]

  @@index([groupId, createdAt])
  @@index([senderId])
}

model GroupMessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model GroupPoll {
  id        String   @id @default(uuid())
  groupId   String
  creatorId String
  question  String
  options   String[]
  createdAt DateTime @default(now())
  expiresAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  votes GroupPollVote[]

  @@index([groupId])
}

model GroupPollVote {
  id       String @id @default(uuid())
  pollId   String
  userId   String
  optionIdx Int

  poll GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  category    String
  description String
  images      String[]
  status      String   @default("open")
  adminReply  String?
  createdAt   DateTime @default(now())
}


// ── Creator Monetization Applications ──
model MonetizationApplication {
  id             String   @id @default(uuid())
  userId         String
  fullName       String
  email          String
  phone          String?
  contentType    String   // "reels" | "posts" | "both"
  niche          String?  // "gaming" | "tech" | "music" | "lifestyle" etc.
  followers      Int
  views30d       Int
  paymentMethod  String?  // "upi" | "bank" | "paypal"
  paymentDetails String?  // UPI ID or bank details
  status         String   @default("pending") // "pending" | "approved" | "rejected"
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


// ── Withdrawal Requests (Creator Earnings Payouts) ──
model WithdrawalRequest {
  id             String   @id @default(uuid())
  userId         String
  amount         Float    // Amount in USD
  status         String   @default("pending") // "pending" | "processing" | "completed" | "rejected"
  paymentMethod  String   // "upi" | "bank" | "paypal"
  paymentDetails String   // UPI ID, bank details JSON, or PayPal email
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── View Rate Limiting (Fake View Protection) ──
model ViewRateLimit {
  id        String   @id @default(uuid())
  ip        String
  postId    String
  count     Int      @default(1)
  date      String   // YYYY-MM-DD format for daily tracking
  createdAt DateTime @default(now())

  @@unique([ip, postId, date])
  @@index([ip, date])
}

// ── Suspicious Activity Flags ──
model SuspiciousActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "rapid_views" | "bot_pattern"
  flaggedAt DateTime @default(now())
  expiresAt DateTime // When the flag expires (1 hour for rapid views)

  @@index([userId, type, expiresAt])
}

// Admin-specific model for admin users (shared with Admin panel)
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


// ── Sound System (TikTok-style original sounds) ──
model Sound {
  id          String   @id @default(uuid())
  title       String   // "Original Sound - @username" or custom name
  audioUrl    String   // Cloudflare R2 URL (.mp3)
  duration    Float?   // seconds
  coverUrl    String?  // thumbnail image
  creatorId   String   // user who created/uploaded this sound
  postId      String?  // source post (if auto-extracted)
  useCount    Int      @default(1) // how many reels use this sound
  createdAt   DateTime @default(now())

  @@index([creatorId])
  @@index([useCount])
}

// ──────────────────────────────────────────────
// VIBE CHAT (Anonymous matching chat)
// ──────────────────────────────────────────────

// A pending "looking for a match" entry
model VibeTicket {
  id              String   @id @default(uuid())
  userId          String
  mood            String   // selected mood key OR custom text
  isCustom        Boolean  @default(false)
  customPrompt    String?  // max 30 words
  status          String   @default("waiting") // waiting | matched | expired
  matchedSessionId String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime // 90s TTL

  user User @relation("VibeTicketUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([mood, status])
  @@index([userId])
}

// An active anonymous chat session between two users
model VibeSession {
  id                String   @id @default(uuid())
  roomId            String   @unique
  user1Id           String
  user2Id           String
  mood              String
  user1CustomPrompt String?
  user2CustomPrompt String?
  status            String   @default("active") // active | revealed | ended
  user1Revealed     Boolean  @default(false)
  user2Revealed     Boolean  @default(false)
  user1Quit         Boolean  @default(false)
  user2Quit         Boolean  @default(false)
  score             Int      @default(0)
  lastMessageAt     DateTime?
  lastSenderId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  endedAt           DateTime?

  room   ChatRoom @relation("VibeRoom", fields: [roomId], references: [id], onDelete: Cascade)
  user1  User     @relation("VibeUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2  User     @relation("VibeUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@index([user1Id, status])
  @@index([user2Id, status])
}

// Daily usage quota (2 free uses/day + bonus from rewarded ads)
model VibeUsage {
  id         String @id @default(uuid())
  userId     String
  date       String // YYYY-MM-DD
  used       Int    @default(0)
  bonusUses  Int    @default(0) // granted by watching rewarded ads

  user User @relation("VibeUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}


// ── App Configuration (Force Update, Maintenance, etc.) ──
model AppConfig {
  id        String   @id @default(uuid())
  key       String   @unique  // e.g., "app_update"
  value     String   // JSON string with config values
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
